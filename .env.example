ENV=PROD
EXCHANGE=bybit

# Bitget API
BITGET_PASSPHRASE=
BITGET_API_KEY=
BITGET_SECRET_KEY=

# Binance HMAC API (no passphrase required)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Bybit HMAC API (Spot trading)
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
BYBIT_BASE_URL=https://api.bybit.com

BOT_TOKEN=
ADMIN_TG_ID=
GROUP_TG_ID=

INTEREST=10
INFLATION=3
# Strategy threshold; the exchange also enforces its current symbol minimums.
MIN_PLATFORM_USD=1
DAILY_BUY_USD=5
