ENV=PROD
EXCHANGE=bitget

# Bitget API (legacy names; BITGET_ prefixed names are also supported)
PASSPHRASE=
API_KEY=
SECRET_KEY=

# Binance HMAC API (no passphrase required)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

BOT_TOKEN=
ADMIN_TG_ID=
GROUP_TG_ID=

INTEREST=10
INFLATION=3
# Strategy threshold; the exchange also enforces its current symbol minimums.
MIN_PLATFORM_USD=1
DAILY_BUY_USD=
